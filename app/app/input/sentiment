#!/usr/local/bin/python

import google.generativeai as genai
import argparse
import json
import sys
import time
import os
from datetime import datetime, timedelta
from guardrails import validate_sentiment_output

sys.path.append(os.path.abspath(os.path.join(os.path.dirname(__file__), '..')))

from database_tools.postgres_handler import PostgresHandler
from intake_streams.prompts.generate_prompt import generate_prompt


# Define the path to the API key file
KEY_FILE_PATH = os.path.join(os.environ["KEYS_DIR"], "gemini", "gemini_key")

# Read the GENAI API key from the file
try:
    with open(KEY_FILE_PATH, "r") as key_file:
        api_key = key_file.read().strip()
except FileNotFoundError:
    print(f"Error: API key file not found at {KEY_FILE_PATH}", file=sys.stderr)
    sys.exit(1)

# Configure the generative AI model with the API key
genai.configure(api_key=api_key)

# Initialize the Gemini model
model = genai.GenerativeModel("gemini-1.5-flash")

def analyze_sentiment(prompt_name, topic, headlines):

    prompt = generate_prompt(prompt_name, topic, headlines)

    response = model.generate_content(prompt)

    RATE_LIMIT_SECONDS = 6
    time.sleep(RATE_LIMIT_SECONDS)

    if not hasattr(response, "text"):
        print("Error: No text response received from the model.", file=sys.stderr)
        sys.exit(1)

    try:
        parsed = json.loads(response.text)
    except json.JSONDecodeError:
        print(f"Error: Failed to parse JSON from model response:\n{response.text}", file=sys.stderr)
        sys.exit(1)

    validated = validate_sentiment_output(parsed)
    if not validated:
        print(f"Error: Output did not pass guardrails:\n{parsed}", file=sys.stderr)
        sys.exit(1)

    print(f"💭 validated sentiment output: {validated}")

    return validated


def main():
    """Main function to parse arguments and run sentiment analysis."""
    parser = argparse.ArgumentParser(description="Assess sentiment of news headlines on a given topic.")
    parser.add_argument("--prompt_name", type=str, required=True, help="The prompt name used for this sentiment analysis.")
    parser.add_argument("--topic", type=str, required=True, help="The topic to analyze sentiment for.")
    parser.add_argument("--since_hours", type=int, default=24,
        help="Only analyze headlines newer than this many hours (default: 24)")

    args = parser.parse_args()

    db_handler = PostgresHandler()

    since = datetime.utcnow() - timedelta(hours=args.since_hours)

    headlines = db_handler.fetch_news_headlines(
        identifier_filter=args.topic, 
        since=since
    )
    if not headlines:
        print("Error: No headlines found in the database.", file=sys.stderr)
        db_handler.close()
        sys.exit(1)

    sentiment_result = analyze_sentiment(args.prompt_name, args.topic, headlines)

    # Generate an identifier using the topic and the current datetime.
    identifier = f"{args.topic}"
    db_handler.insert_sentiment_result(sentiment_result, identifier=identifier)

    print(f"Sentiment analysis saved with identifier: {identifier}")
    db_handler.close()


if __name__ == "__main__":
    main()
